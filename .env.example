# Copy to .env (git-ignored) and change the values:   cp .env.example .env
# These are local development credentials only. Never commit .env.

POSTGRES_PASSWORD=change-me-postgres
CLAIMS_DB_PASSWORD=change-me-claims
NOTIFICATIONS_DB_PASSWORD=change-me-notifications

RABBITMQ_USER=claims
RABBITMQ_PASSWORD=change-me-rabbitmq

# Where confirmation emails go:
#   mailpit  - captured locally, view at http://localhost:8025 (default, no account needed)
#   resend   - real delivery via Resend's free tier, with duplicate protection (needs RESEND_API_KEY)
EMAIL_PROVIDER=mailpit

# Only for EMAIL_PROVIDER=resend. Create one at https://resend.com/api-keys ("Sending access").
# Without a verified domain, Resend only delivers to the email address on your Resend account.
RESEND_API_KEY=
